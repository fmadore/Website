{
	"name": "frederick-madore-website",
	"private": true,
	"version": "2.1.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"workspaces": [
		"mcp"
	],
	"scripts": {
		"dev": "vite dev",
		"predev": "npm run gen:images",
		"build": "vite build",
		"prebuild": "npm run gen:refs && npm run gen:prose && npm run gen:images",
		"gen:images": "node scripts/generate-image-variants.mjs",
		"check:images": "node scripts/generate-image-variants.mjs --check",
		"preview": "vite preview",
		"gen:refs": "node scripts/generate-reference-index.mjs",
		"gen:prose": "node scripts/generate-research-prose.mjs",
		"gen:posters": "node scripts/generate-slide-posters.mjs",
		"shot": "node scripts/screenshot.mjs",
		"check:links": "node scripts/check-links.mjs",
		"check:slides": "node scripts/check-slides.mjs",
		"check:citations": "node scripts/check-citations.mjs",
		"check:bundle": "node scripts/check-bundle-budget.mjs",
		"check:prerender": "node scripts/check-prerender.mjs",
		"check:build": "npm run check:images && npm run check:bundle && npm run check:prerender",
		"mcp:build": "npm run build -w mcp",
		"mcp:check": "npm run check -w mcp",
		"mcp:pack": "npm run pack -w mcp",
		"mcp:smoke": "npm run mcp:build && npm run mcp:pack && npm run smoke -w mcp",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:tsgo": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:all": "npm run lint && npm run check && npm run test && npm run test:e2e",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"serve:https": "npx serve build -l 8080 --ssl-cert localhost.pem --ssl-key localhost-key.pem",
		"sync:talks": "node scripts/sync-talks-to-vault.mjs",
		"sync:projects": "node scripts/sync-projects-to-vault.mjs",
		"sync:publications": "node scripts/sync-publications-to-vault.mjs",
		"sync:vault": "npm run sync:publications -- --write && npm run sync:projects -- --write && npm run sync:sections -- --write && npm run sync:talks -- --write",
		"sync:sections": "node scripts/sync-sections-to-vault.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@csstools/postcss-global-data": "^4.0.0",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/d3": "^7.4.3",
		"@types/node": "^26.4.0",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"postcss": "^8.5.25",
		"postcss-custom-media": "^12.0.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"serve": "^14.2.6",
		"sharp": "^0.35.3",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.0",
		"vitest": "^4.1.10"
	},
	"overrides": {
		"js-yaml": ">=4.1.1",
		"devalue": ">=5.8.1",
		"brace-expansion": ">=5.0.9",
		"echarts-wordcloud": {
			"echarts": "$echarts"
		},
		"dompurify": "^3.4.12",
		"fast-uri": "^3.1.5",
		"cookie": ">=0.7.0",
		"hono": ">=4.12.34",
		"protocol-buffers-schema": ">=3.6.1"
	},
	"dependencies": {
		"@iconify-icons/academicons": "^1.2.10",
		"@iconify-icons/lucide": "^1.2.135",
		"@iconify-icons/mdi": "^1.2.48",
		"@iconify-icons/simple-icons": "^1.2.74",
		"@iconify/svelte": "^5.2.2",
		"d3": "^7.9.0",
		"echarts": "^6.1.0",
		"echarts-wordcloud": "^2.1.0",
		"jspdf": "^4.2.1",
		"maplibre-gl": "^6.1.0"
	}
}
